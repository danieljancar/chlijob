# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local, .env.staging, or .env.production.

# Supabase
# Get these from `supabase status` after running `supabase start`
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_ENV=local
